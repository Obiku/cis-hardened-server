t="1" source="a26" target="a28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a55" value="A: credentials&lt;br&gt;(IMDSv2)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#232F3E;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;dashed=1;strokeWidth=1;strokeColor=#5A6B86;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="a30" target="a16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a56" value="B: encrypts" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#232F3E;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;dashed=1;strokeWidth=1;strokeColor=#DD344C;fontColor=#DD344C;exitX=0.5;exitY=0;entryX=1;entryY=0.5;" edge="1" parent="1" source="a32" target="a22"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1320" y="390"/></Array></mxGeometry></mxCell><mxCell id="a57" value="B: encrypts" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#232F3E;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;dashed=1;strokeWidth=1;strokeColor=#DD344C;fontColor=#DD344C;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="a32" target="a20"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1320" y="680"/></Array></mxGeometry></mxCell><mxCell id="a58" value="B: encrypts the disk" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#232F3E;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;dashed=1;strokeWidth=1;strokeColor=#DD344C;fontColor=#DD344C;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="a32" target="a34"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1065" y="520"/><mxPoint x="1065" y="800"/><mxPoint x="440" y="800"/><mxPoint x="440" y="590"/></Array></mxGeometry></mxCell><mxCell id="a59" value="D: records every change,&lt;br&gt;flags port 22 open" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#232F3E;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;dashed=1;strokeWidth=1;strokeColor=#E7157B;fontColor=#E7157B;exitX=0.5;exitY=0;entryX=0.37;entryY=1;" edge="1" parent="1" source="a38" target="a5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a60" value="D to E" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#232F3E;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;dashed=1;strokeWidth=1;strokeColor=#E7157B;fontColor=#E7157B;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="a38" target="a36"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a61" value="D to F: findings" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#232F3E;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;dashed=1;strokeWidth=1;strokeColor=#E7157B;fontColor=#E7157B;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="a38" target="a40"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a62" value="G to H: terraform plan and apply read and lock the state" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#232F3E;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;strokeColor=#5A6B86;exitX=1;exitY=0.25;entryX=1;entryY=0.5;" edge="1" parent="1" source="a42" target="a44"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="170" y="865"/><mxPoint x="170" y="1060"/><mxPoint x="1240" y="1060"/><mxPoint x="1240" y="880"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram name="2 Build order" id="b"><mxGraphModel background="#FFFFFF" dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1020" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="b1" value="Build order: what each step creates in AWS, and what it waits for" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="1200" height="36" as="geometry"/></mxCell><mxCell id="b2" value="&lt;b&gt;Key:&lt;/b&gt; each box lists the AWS resources it creates (count in brackets). Solid arrow: a value is passed; the step at the arrow head waits for the step at its tail. Dashed arrow: depends_on, an ordering rule with no value passed. Colours follow the AWS service." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="34" width="1700" height="40" as="geometry"/></mxCell><mxCell id="b3" value='&lt;b style="font-size:15px;"&gt;T1 bootstrap (6)&lt;/b&gt;&lt;br&gt;S3 bucket cis-hardened-server-tfstate-...&lt;br&gt;versioning, encryption,&lt;br&gt;public access block, ownership, policy&lt;br&gt;&lt;i&gt;run once ever, local state&lt;/i&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#FFFFFF;strokeColor=#FFFFFF;strokeWidth=1;fillColor=#3F8624;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="320" height="130" as="geometry"/></mxCell><mxCell id="b4" value='&lt;b style="font-size:15px;"&gt;T2 envs/dev (no resources)&lt;/b&gt;&lt;br&gt;backend.tf, providers.tf, variables.tf,&lt;br&gt;main.tf, outputs.tf&lt;br&gt;&lt;i&gt;you run terraform apply here&lt;/i&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#FFFFFF;strokeColor=#FFFFFF;strokeWidth=1;fillColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="470" y="90" width="320" height="130" as="geometry"/></mxCell><mxCell id="b5" value="One terraform apply in envs/dev builds everything in this box: 52 resources. Terraform works out the order from the arrows." style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;fontSize=14;fontStyle=1;dashed=1;strokeWidth=2;fillColor=none;strokeColor=#5A6B86;fontColor=#5A6B86;" vertex="1" parent="1"><mxGeometry x="20" y="270" width="1780" height="760" as="geometry"/></mxCell><mxCell id="b6" value='&lt;b style="font-size:15px;"&gt;T3 network (21)&lt;/b&gt;&lt;br&gt;VPC, 2 subnets, internet gateway,&lt;br&gt;Elastic IP, NAT gateway,&lt;br&gt;2 route tables + 2 associations,&lt;br&gt;2 security groups + 3 rules,&lt;br&gt;5 interface endpoints, S3 gateway endpoint' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#FFFFFF;strokeColor=#FFFFFF;strokeWidth=1;fillColor=#8C4FFF;" vertex="1" parent="1"><mxGeometry x="60" y="330" width="320" height="160" as="geometry"/></mxCell><mxCell id="b7" value='&lt;b style="font-size:15px;"&gt;T7 compute (3)&lt;/b&gt;&lt;br&gt;EBS encryption by default,&lt;br&gt;EBS default KMS key,&lt;br&gt;EC2 instance cis-server&lt;br&gt;(with its user data)' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#FFFFFF;strokeColor=#FFFFFF;strokeWidth=1;fillColor=#ED7100;" vertex="1" parent="1"><mxGeometry x="1040" y="330" width="320" height="160" as="geometry"/></mxCell><mxCell id="b8" value='&lt;b style="font-size:15px;"&gt;T8 monitoring (10)&lt;/b&gt;&lt;br&gt;Config bucket + access block + policy,&lt;br&gt;Config recorder, delivery channel,&lt;br&gt;recorder status, rule restricted-ssh,&lt;br&gt;Security Hub + 2 standards' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#FFFFFF;strokeColor=#FFFFFF;strokeWidth=1;fillColor=#B0084D;" vertex="1" parent="1"><mxGeometry x="1460" y="330" width="320" height="160" as="geometry"/></mxCell><mxCell id="b9" value='&lt;b style="font-size:15px;"&gt;T4 kms (2)&lt;/b&gt;&lt;br&gt;KMS customer managed key,&lt;br&gt;alias/cis-hardened-key' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#FFFFFF;strokeColor=#FFFFFF;strokeWidth=1;fillColor=#DD344C;" vertex="1" parent="1"><mxGeometry x="60" y="620" width="280" height="120" as="geometry"/></mxCell><mxCell id="b10" value='&lt;b style="font-size:15px;"&gt;T4 evidence (6)&lt;/b&gt;&lt;br&gt;S3 bucket cis-evidence-...&lt;br&gt;ownership, access block, versioning,&lt;br&gt;encryption, bucket policy' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#FFFFFF;strokeColor=#FFFFFF;strokeWidth=1;fillColor=#3F8624;" vertex="1" parent="1"><mxGeometry x="400" y="620" width="280" height="120" as="geometry"/></mxCell><mxCell id="b11" value='&lt;b style="font-size:15px;"&gt;T5 iam (6)&lt;/b&gt;&lt;br&gt;IAM policy cis-evidence-upload-policy,&lt;br&gt;IAM role cis-instance-role,&lt;br&gt;3 policy attachments, instance profile' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#FFFFFF;strokeColor=#FFFFFF;strokeWidth=1;fillColor=#A4001F;" vertex="1" parent="1"><mxGeometry x="740" y="620" width="280" height="120" as="geometry"/></mxCell><mxCell id="b12" value='&lt;b style="font-size:15px;"&gt;T6 logging (4)&lt;/b&gt;&lt;br&gt;CloudWatch Logs log groups&lt;br&gt;/cis/ssm-sessions, /cis/auth, /cis/evidence,&lt;br&gt;SSM document (Session Manager prefs)' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#FFFFFF;strokeColor=#FFFFFF;strokeWidth=1;fillColor=#E7157B;" vertex="1" parent="1"><mxGeometry x="400" y="860" width="300" height="130" as="geometry"/></mxCell><mxCell id="b13" value="state kept&lt;br&gt;in this bucket" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#232F3E;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="b3" target="b4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b14" value="calls every module&lt;br&gt;(T3 to T8)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#232F3E;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.5;exitY=1;entryX=0.35;entryY=0;" edge="1" parent="1" source="b4" target="b5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b15" value="private subnet ID, instance security group ID" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#232F3E;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="b6" target="b7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b16" value="key ARN" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#232F3E;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="b9" target="b10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b17" value="bucket ARN" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#232F3E;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="b10" target="b11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b18" value="key ARN" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#232F3E;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" edge="1" parent="1" source="b9" target="b11"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="200" y="580"/><mxPoint x="880" y="580"/></Array></mxGeometry></mxCell><mxCell id="b19" value="key ARN" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#232F3E;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=0.3;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="b9" target="b12"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="144" y="925"/></Array></mxGeometry></mxCell><mxCell id="b20" value="key ARN (disk)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#232F3E;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=0.7;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="b9" target="b7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="256" y="790"/><mxPoint x="1200" y="790"/></Array></mxGeometry></mxCell><mxCell id="b21" value="instance&lt;br&gt;profile name" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#232F3E;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0.13;entryY=1;" edge="1" parent="1" source="b11" target="b7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1082" y="680"/></Array></mxGeometry></mxCell><mxCell id="b22" value="depends_on: T7 waits for T6&lt;br&gt;(log groups exist before first boot)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#232F3E;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;dashed=1;exitX=1;exitY=0.5;entryX=0.87;entryY=1;" edge="1" parent="1" source="b12" target="b7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1318" y="925"/></Array></mxGeometry></mxCell><mxCell id="b23" value="depends_on:&lt;br&gt;T8 waits&lt;br&gt;for T7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#232F3E;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="b7" target="b8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram name="3 First boot of the server" id="c"><mxGraphModel background="#FFFFFF" dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1020" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="First boot: how the server sets itself up with nobody logging in" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="1200" height="36" as="geometry"/></mxCell><mxCell id="c2" value="ON YOUR LAPTOP" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;fontSize=14;fontStyle=1;dashed=1;strokeWidth=2;fillColor=none;strokeColor=#5A6B86;fontColor=#5A6B86;" vertex="1" parent="1"><mxGeometry x="20" y="50" width="310" height="190" as="geometry"/></mxCell><mxCell id="c3" value="ON THE SERVER: FIRST BOOT ONLY (cloud-init)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;fontSize=14;fontStyle=1;dashed=1;strokeWidth=2;fillColor=none;strokeColor=#8C4FFF;fontColor=#8C4FFF;" vertex="1" parent="1"><mxGeometry x="350" y="50" width="980" height="380" as="geometry"/></mxCell><mxCell id="c4" value="ON THE SERVER: EVERY DAY" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;fontSize=14;fontStyle=1;dashed=1;strokeWidth=2;fillColor=none;strokeColor=#ED7100;fontColor=#ED7100;" vertex="1" parent="1"><mxGeometry x="20" y="470" width="310" height="420" as="geometry"/></mxCell><mxCell id="c5" value="IN AWS" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;fontSize=14;fontStyle=1;dashed=1;strokeWidth=2;fillColor=none;strokeColor=#3F8624;fontColor=#3F8624;" vertex="1" parent="1"><mxGeometry x="400" y="470" width="360" height="420" as="geometry"/></mxCell><mxCell id="c6" value='&lt;b style="font-size:15px;"&gt;0. terraform apply&lt;/b&gt;&lt;br&gt;templatefile() fills cloud-init.yaml.tftpl&lt;br&gt;with harden.sh and cis-check.sh&lt;br&gt;(base64); AWS creates the server&lt;br&gt;with this user data' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#FFFFFF;strokeColor=#FFFFFF;strokeWidth=1;fillColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="270" height="110" as="geometry"/></mxCell><mxCell id="c7" value='&lt;b style="font-size:15px;"&gt;1. Server starts&lt;/b&gt;&lt;br&gt;cloud-init fetches the user data&lt;br&gt;from IMDS, once, at first boot' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#FFFFFF;strokeColor=#FFFFFF;strokeWidth=1;fillColor=#8C4FFF;" vertex="1" parent="1"><mxGeometry x="370" y="100" width="270" height="110" as="geometry"/></mxCell><mxCell id="c8" value='&lt;b style="font-size:15px;"&gt;2. write_files&lt;/b&gt;&lt;br&gt;harden.sh, cis-check.sh (0700),&lt;br&gt;cis-check.service, .timer (0644),&lt;br&gt;CloudWatch agent settings (0600)' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#FFFFFF;strokeColor=#FFFFFF;strokeWidth=1;fillColor=#8C4FFF;" vertex="1" parent="1"><mxGeometry x="690" y="100" width="300" height="110" as="geometry"/></mxCell><mxCell id="c9" value='&lt;b style="font-size:15px;"&gt;3. runcmd: harden.sh&lt;/b&gt;&lt;br&gt;root login off, services masked,&lt;br&gt;file permissions, auditd + rules,&lt;br&gt;automatic security updates' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#FFFFFF;strokeColor=#FFFFFF;strokeWidth=1;fillColor=#DD344C;" vertex="1" parent="1"><mxGeometry x="1030" y="100" width="280" height="110" as="geometry"/></mxCell><mxCell id="c10" value='&lt;b style="font-size:15px;"&gt;4. runcmd: tools&lt;/b&gt;&lt;br&gt;jq (apt, through NAT)&lt;br&gt;AWS CLI (snap, through NAT)' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#FFFFFF;strokeColor=#FFFFFF;strokeWidth=1;fillColor=#ED7100;" vertex="1" parent="1"><mxGeometry x="1030" y="290" width="280" height="110" as="geometry"/></mxCell><mxCell id="c11" value='&lt;b style="font-size:15px;"&gt;5. runcmd: CloudWatch agent&lt;/b&gt;&lt;br&gt;download through S3 gateway endpoint,&lt;br&gt;install, load settings, start' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#FFFFFF;strokeColor=#FFFFFF;strokeWidth=1;fillColor=#E7157B;" vertex="1" parent="1"><mxGeometry x="690" y="290" width="300" height="110" as="geometry"/></mxCell><mxCell id="c12" value='&lt;b style="font-size:15px;"&gt;6. runcmd: timer&lt;/b&gt;&lt;br&gt;daemon-reload, enable --now the timer,&lt;br&gt;start the service&lt;br&gt;(first check runs now)' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#FFFFFF;strokeColor=#FFFFFF;strokeWidth=1;fillColor=#067F68;" vertex="1" parent="1"><mxGeometry x="370" y="290" width="270" height="110" as="geometry"/></mxCell><mxCell id="c13" value='&lt;b style="font-size:15px;"&gt;7. cis-check.sh&lt;/b&gt;&lt;br&gt;10 checks, each PASS or FAIL&lt;br&gt;JSON saved in /var/log/cis-evidence/' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#FFFFFF;strokeColor=#FFFFFF;strokeWidth=1;fillColor=#0972D3;" vertex="1" parent="1"><mxGeometry x="40" y="530" width="270" height="110" as="geometry"/></mxCell><mxCell id="c14" value='&lt;b style="font-size:15px;"&gt;10. Every day at 00:00 UTC&lt;/b&gt;&lt;br&gt;the timer runs cis-check.sh again&lt;br&gt;(Persistent=true: a missed run&lt;br&gt;happens at next boot)' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#FFFFFF;strokeColor=#FFFFFF;strokeWidth=1;fillColor=#067F68;" vertex="1" parent="1"><mxGeometry x="40" y="750" width="270" height="110" as="geometry"/></mxCell><mxCell id="c15" value='&lt;b style="font-size:15px;"&gt;8. Evidence bucket&lt;/b&gt;&lt;br&gt;aws s3 cp through S3 gateway endpoint&lt;br&gt;evidence/&amp;lt;instance-id&amp;gt;/&amp;lt;date&amp;gt;/&lt;br&gt;encrypted with the KMS key' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#FFFFFF;strokeColor=#FFFFFF;strokeWidth=1;fillColor=#3F8624;" vertex="1" parent="1"><mxGeometry x="420" y="530" width="320" height="110" as="geometry"/></mxCell><mxCell id="c16" value='&lt;b style="font-size:15px;"&gt;9. CloudWatch /cis/evidence&lt;/b&gt;&lt;br&gt;the CloudWatch agent ships the same&lt;br&gt;JSON file through the logs endpoint' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#FFFFFF;strokeColor=#FFFFFF;strokeWidth=1;fillColor=#E7157B;" vertex="1" parent="1"><mxGeometry x="420" y="750" width="320" height="110" as="geometry"/></mxCell><mxCell id="c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#232F3E;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#232F3E;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#232F3E;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#232F3E;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#232F3E;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#232F3E;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="first run" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#232F3E;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.95;entryY=0;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="505" y="450"/><mxPoint x="296" y="450"/></Array></mxGeometry></mxCell><mxCell id="c24" value="upload" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#232F3E;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3;entryX=0;entryY=0.3;" edge="1" parent="1" source="c13" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="agent reads&lt;br&gt;the file" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#232F3E;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.8;entryX=0;entryY=0.5;" edge="1" parent="1" source="c13" target="c16"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="365" y="618"/><mxPoint x="365" y="805"/></Array></mxGeometry></mxCell><mxCell id="c26" value="repeats daily" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#232F3E;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="c14" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c27" value="&lt;b&gt;Proof it worked (this build)&lt;/b&gt;&lt;br&gt;cloud-init status: done&lt;br&gt;/var/log/cis-hardening.log ends with CIS hardening finished&lt;br&gt;first evidence file 10/10 PASS about 10 seconds later&lt;br&gt;log streams named after the instance in /cis/auth and /cis/evidence" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="800" y="530" width="480" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
