        <mxCell id="a50" edge="1" parent="1" source="a10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#232F3E;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.85;entryX=0;entryY=0.25;" target="a20" value="2 to 7: session&lt;br&gt;recording">
