        <mxCell id="a51" edge="1" parent="1" source="a14" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#232F3E;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;entryX=1;entryY=0.5;" target="a22" value="4 to 8: package&lt;br&gt;updates only">
          <mxGeometry relative="1" as="geometry">
