            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="a52" edge="1" parent="1" source="a22" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#232F3E;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" target="a24" value="8 to 9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a53" edge="1" parent="1" source="a24" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#232F3E;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" target="a26" value="9 to 10">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a54" edge="1" parent="1" source="a28" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#232F3E;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;dashed=1;strokeWidth=1;strokeColor=#5A6B86;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="a14" value="A: credentials&lt;br&gt;(IMDSv2)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a55" edge="1" parent="1" source="a30" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#232F3E;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;dashed=1;strokeWidth=1;strokeColor=#DD344C;fontColor=#DD344C;exitX=0.5;exitY=0;entryX=1;entryY=0.5;" target="a20" value="B: encrypts">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1320" y="390" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="a56" edge="1" parent="1" source="a30" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#232F3E;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;dashed=1;strokeWidth=1;strokeColor=#DD344C;fontColor=#DD344C;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" target="a18" value="B: encrypts">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1320" y="620" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="a57" edge="1" parent="1" source="a30" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#232F3E;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;dashed=1;strokeWidth=1;strokeColor=#DD344C;fontColor=#DD344C;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" target="a32" value="B: encrypts the disk">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1085" y="500" />
              <mxPoint x="1085" y="710" />
              <mxPoint x="725" y="710" />
              <mxPoint x="725" y="615" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="a58" edge="1" parent="1" source="a36" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#232F3E;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;dashed=1;strokeWidth=1;strokeColor=#E7157B;fontColor=#E7157B;exitX=0.5;exitY=0;entryX=0.38;entryY=1;" target="a5" value="D: records every change,&lt;br&gt;flags port 22 open">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a59" edge="1" parent="1" source="a36" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#232F3E;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;dashed=1;strokeWidth=1;strokeColor=#E7157B;fontColor=#E7157B;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" target="a34" value="D to E">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a60" edge="1" parent="1" source="a36" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#232F3E;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;dashed=1;strokeWidth=1;strokeColor=#E7157B;fontColor=#E7157B;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="a38" value="D to F: findings">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a61" edge="1" parent="1" source="a40" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#232F3E;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;strokeColor=#5A6B86;exitX=1;exitY=0.25;entryX=1;entryY=0.5;" target="a42" value="G to H: terraform plan and apply read and lock the state">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="170" y="805" />
              <mxPoint x="170" y="990" />
              <mxPoint x="1240" y="990" />
              <mxPoint x="1240" y="820" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="a62" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;fontSize=16;fontStyle=1;fontColor=#FFFFFF;fillColor=#232F3E;strokeColor=#232F3E;" value="How to read this diagram&lt;br&gt;&lt;font style=&quot;font-size:12px;font-weight:normal;&quot; color=&quot;#FF9900&quot;&gt;Follow the numbers 1 to 10, then the letters&lt;/font&gt;" vertex="1">
          <mxGeometry height="64" width="460" x="1620" y="70" as="geometry" />
        </mxCell>
        <mxCell id="a63" parent="1" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;spacingTop=12;fontSize=13;fontColor=#232F3E;fillColor=#FFFFFF;strokeColor=#FF9900;strokeWidth=2;" value="&lt;span style=&quot;background-color:#232F3E;color:#FFFFFF;font-weight:bold;&quot;&gt;&amp;nbsp;1&amp;nbsp;&lt;/span&gt;&amp;nbsp;&amp;nbsp;&lt;b&gt;&lt;font color=&quot;#EC7211&quot;&gt;Administrator&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Top right, outside AWS. Starts a session from the browser. No SSH, no key pair.&lt;br&gt;&lt;br&gt;&lt;span style=&quot;background-color:#232F3E;color:#FFFFFF;font-weight:bold;&quot;&gt;&amp;nbsp;2&amp;nbsp;&lt;/span&gt;&amp;nbsp;&amp;nbsp;&lt;b&gt;&lt;font color=&quot;#EC7211&quot;&gt;Systems Manager&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Checks the administrator&#39;s IAM permissions, then sends the session on.&lt;br&gt;&lt;br&gt;&lt;span style=&quot;background-color:#232F3E;color:#FFFFFF;font-weight:bold;&quot;&gt;&amp;nbsp;3&amp;nbsp;&lt;/span&gt;&amp;nbsp;&amp;nbsp;&lt;b&gt;&lt;font color=&quot;#EC7211&quot;&gt;Interface endpoints&lt;/font&gt;&lt;/b&gt;&lt;br&gt;The private door into the VPC. The session reaches the server through them.&lt;br&gt;&lt;br&gt;&lt;span style=&quot;background-color:#232F3E;color:#FFFFFF;font-weight:bold;&quot;&gt;&amp;nbsp;4&amp;nbsp;&lt;/span&gt;&amp;nbsp;&amp;nbsp;&lt;b&gt;&lt;font color=&quot;#EC7211&quot;&gt;cis-server&lt;/font&gt;&lt;/b&gt;&lt;br&gt;The session opens here. The server never accepts incoming connections: its agents connected out first, and the session comes back down that connection. Logs go out the same way. Outbound 443 and 80 only.&lt;br&gt;&lt;br&gt;&lt;span style=&quot;background-color:#232F3E;color:#FFFFFF;font-weight:bold;&quot;&gt;&amp;nbsp;5&amp;nbsp;&lt;/span&gt;&amp;nbsp;&amp;nbsp;&lt;b&gt;&lt;font color=&quot;#EC7211&quot;&gt;S3 gateway endpoint&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Once a day the check script sends its JSON evidence file here.&lt;br&gt;&lt;br&gt;&lt;span style=&quot;background-color:#232F3E;color:#FFFFFF;font-weight:bold;&quot;&gt;&amp;nbsp;6&amp;nbsp;&lt;/span&gt;&amp;nbsp;&amp;nbsp;&lt;b&gt;&lt;font color=&quot;#EC7211&quot;&gt;Evidence bucket&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Stores the file under evidence/. The server can add files but never read or delete them.&lt;br&gt;&lt;br&gt;&lt;span style=&quot;background-color:#232F3E;color:#FFFFFF;font-weight:bold;&quot;&gt;&amp;nbsp;7&amp;nbsp;&lt;/span&gt;&amp;nbsp;&amp;nbsp;&lt;b&gt;&lt;font color=&quot;#EC7211&quot;&gt;CloudWatch Logs&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Receives server logs from 3 and the session recording from 2.&lt;br&gt;&lt;br&gt;&lt;span style=&quot;background-color:#232F3E;color:#FFFFFF;font-weight:bold;&quot;&gt;&amp;nbsp;8 9 10&amp;nbsp;&lt;/span&gt;&amp;nbsp;&amp;nbsp;&lt;b&gt;&lt;font color=&quot;#EC7211&quot;&gt;NAT, internet gateway, internet&lt;/font&gt;&lt;/b&gt;&lt;br&gt;The only route out, used for package updates. Nothing on the internet can start a connection in.&lt;br&gt;&lt;br&gt;&lt;b&gt;SUPPORTING PARTS&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;background-color:#5A6B86;color:#FFFFFF;font-weight:bold;&quot;&gt;&amp;nbsp;A&amp;nbsp;&lt;/span&gt;&amp;nbsp;&amp;nbsp;&lt;b&gt;&lt;font color=&quot;#EC7211&quot;&gt;Role&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Short-lived credentials through IMDSv2. No keys stored on the server.&lt;br&gt;&lt;br&gt;&lt;span style=&quot;background-color:#5A6B86;color:#FFFFFF;font-weight:bold;&quot;&gt;&amp;nbsp;B&amp;nbsp;&lt;/span&gt;&amp;nbsp;&amp;nbsp;&lt;b&gt;&lt;font color=&quot;#EC7211&quot;&gt;KMS key&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Encrypts the evidence bucket, the logs and the disk (C).&lt;br&gt;&lt;br&gt;&lt;span style=&quot;background-color:#5A6B86;color:#FFFFFF;font-weight:bold;&quot;&gt;&amp;nbsp;D E F&amp;nbsp;&lt;/span&gt;&amp;nbsp;&amp;nbsp;&lt;b&gt;&lt;font color=&quot;#EC7211&quot;&gt;Config, Config bucket, Security Hub&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Config records every change in the VPC and flags port 22 open to the world. History goes to E, findings to F.&lt;br&gt;&lt;br&gt;&lt;span style=&quot;background-color:#5A6B86;color:#FFFFFF;font-weight:bold;&quot;&gt;&amp;nbsp;G H&amp;nbsp;&lt;/span&gt;&amp;nbsp;&amp;nbsp;&lt;b&gt;&lt;font color=&quot;#EC7211&quot;&gt;Terraform and its state&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Terraform on the laptop builds everything and keeps its state, with a lock, in H.&lt;br&gt;&lt;br&gt;" vertex="1">
          <mxGeometry height="828" width="460" x="1620" y="142" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="2 Build order" id="b">
